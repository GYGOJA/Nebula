# Copy to .env and fill in:  cp .env.docker.example .env
DB_USER=nebula
DB_PASSWORD=change_me_db_password
DB_NAME=nebula

# Long random string, e.g.:  openssl rand -hex 48
JWT_SECRET=change_me_long_random_secret

# Gmail account used to send registration / email-change codes (app password).
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Local testing without Gmail: true = codes are printed in `docker compose logs api`.
MAIL_LOG_ONLY=false

# Optional TURN server for calls behind strict NATs.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Host port for the web app.
WEB_PORT=8081
